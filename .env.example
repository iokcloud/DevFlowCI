# DevFlow CI - 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# DeepSeek API
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 日常/CI 推荐 deepseek-v4-flash；重要交付可改为 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
# V4 thinking effort（规划类 Agent）：high | max
# DEEPSEEK_REASONING_EFFORT=high

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./database/devflow.db

# 日志级别
LOG_LEVEL=INFO

# 商业 MVP 模块上限（须在启动服务前设置）
# 1 = 默认，Phase-1 单模块（生产推荐）
# 2 = 多模块商业路径（weekly multi E2E 使用此值）
# ≥3 = 实验性，不保证 E2E 通过
# BUSINESS_MVP_MAX_MODULES=1
